"""
Create Draft Modal Component
Mirrors CreateDraftModal.tsx from React frontend
Allows users to create media plan drafts with budget selection
"""

import streamlit as st
from typing import Dict, Any
import json


# Predefined budget options (in thousands)
PREDEFINED_BUDGETS = [50, 100, 150, 200, 250, 300, 400, 500]


def format_budget_display(value: int) -> str:
    """Format budget for display (e.g., 100 -> 100k)"""
    return f"{value}k"


def parse_budget_value(display_value: str) -> int:
    """Parse budget from display format back to numeric (e.g., '100k' -> 100000)"""
    # Remove 'k' suffix if present
    value_str = display_value.replace('k', '').replace('K', '').strip()
    try:
        num_value = float(value_str)
        # If value is less than 1000, assume it's already in 'k' format
        if num_value < 1000:
            return int(num_value)
        return int(num_value / 1000)
    except:
        return 100  # Default to 100k


def create_draft_modal(form_data: Dict[str, Any], insights: Dict[str, Any], api_service, on_close_callback):
    """
    Create Draft Modal - matches React CreateDraftModal.tsx functionality

    Args:
        form_data: Complete form data from media plan form
        insights: Generated insights data
        api_service: API service instance
        on_close_callback: Callback function to close modal
    """

    st.markdown("### ⚙️ Create Media Plan Draft")
    st.markdown("Save this media plan configuration as a draft for the specified budget and format")

    # Initialize session state for modal
    if 'draft_budget_level' not in st.session_state:
        # Auto-suggest budget based on existing form data or default to 100
        if form_data.get('micro_amount'):
            existing_budget_k = round(form_data['micro_amount'] / 1000000)
            st.session_state.draft_budget_level = existing_budget_k
        else:
            st.session_state.draft_budget_level = 100

    if 'draft_asset_format' not in st.session_state:
        # Auto-select asset format from form data
        st.session_state.draft_asset_format = form_data.get('asset_formats', 'AUDIO')

    if 'draft_custom_budget_mode' not in st.session_state:
        st.session_state.draft_custom_budget_mode = False

    if 'draft_created' not in st.session_state:
        st.session_state.draft_created = False

    # Success message if draft was just created
    if st.session_state.draft_created:
        st.success("✅ Draft Created Successfully!")
        st.info("Your media plan draft has been saved. You can now view all your drafts or continue creating more.")
        st.markdown("---")

    # Campaign Information (Auto-selected)
    st.markdown("#### ℹ️ Campaign & Asset Format (Auto-selected)")
    col1, col2 = st.columns(2)
    with col1:
        st.markdown("**Campaign Name:**")
        st.markdown(f"<h3 style='color: #1DB954; margin: 0;'>{form_data.get('campaign_name', 'N/A')}</h3>", unsafe_allow_html=True)
    with col2:
        st.markdown("**Asset Format:**")
        st.markdown(f"<h3 style='color: #3B82F6; margin: 0;'>{st.session_state.draft_asset_format}</h3>", unsafe_allow_html=True)

    st.markdown("---")

    # Budget Level Selection
    st.markdown("#### 💵 Budget Level *")
    st.markdown("Select a predefined budget or enter a custom amount")

    # Predefined Budget Buttons (4 columns)
    cols = st.columns(4)
    for idx, budget in enumerate(PREDEFINED_BUDGETS):
        with cols[idx % 4]:
            if st.button(
                format_budget_display(budget),
                key=f"budget_btn_{budget}",
                use_container_width=True,
                type="primary" if st.session_state.draft_budget_level == budget else "secondary"
            ):
                st.session_state.draft_budget_level = budget
                st.session_state.draft_custom_budget_mode = False
                st.rerun()

    # Custom Budget Toggle
    if st.button(
        "🔢 " + ("Hide" if st.session_state.draft_custom_budget_mode else "Enter") + " Custom Budget",
        key="custom_budget_toggle"
    ):
        st.session_state.draft_custom_budget_mode = not st.session_state.draft_custom_budget_mode
        st.rerun()

    # Custom Budget Input
    if st.session_state.draft_custom_budget_mode:
        custom_budget = st.number_input(
            "Custom Budget (in thousands, e.g., 150 = $150,000)",
            min_value=1,
            value=st.session_state.draft_budget_level,
            step=1,
            key="custom_budget_input"
        )
        st.session_state.draft_budget_level = int(custom_budget)

    st.caption("💡 Values shown in thousands (e.g., 100k = $100,000)")

    st.markdown("---")

    # Draft Summary Preview
    st.markdown("#### 📋 Draft Summary")
    summary_col1, summary_col2 = st.columns(2)

    with summary_col1:
        st.markdown("**Campaign:**")
        st.write(form_data.get('campaign_name', 'N/A'))

        st.markdown("**Budget Name:**")
        st.write(form_data.get('campaign_name', 'N/A'))

        st.markdown("**Budget Amount:**")
        st.write(format_budget_display(st.session_state.draft_budget_level))

    with summary_col2:
        st.markdown("**Format:**")
        st.write(st.session_state.draft_asset_format)

        st.markdown("**Objective:**")
        st.write(form_data.get('campaign_objective', 'N/A'))

        st.markdown("**Countries:**")
        countries = form_data.get('countries', 'N/A')
        if isinstance(countries, list):
            st.write(', '.join(countries[:3]) if len(countries) > 0 else 'N/A')
        else:
            st.write(countries)

    st.markdown("---")

    # Action Buttons
    button_col1, button_col2 = st.columns(2)

    with button_col1:
        if st.button("❌ Cancel", key="cancel_draft", use_container_width=True):
            # Clean up session state
            for key in ['draft_budget_level', 'draft_asset_format', 'draft_custom_budget_mode', 'draft_created']:
                if key in st.session_state:
                    del st.session_state[key]
            on_close_callback()
            st.rerun()

    with button_col2:
        if st.session_state.draft_created:
            if st.button("📁 View All Drafts", key="view_drafts", use_container_width=True, type="primary"):
                # Clean up and navigate
                for key in ['draft_budget_level', 'draft_asset_format', 'draft_custom_budget_mode', 'draft_created', 'show_draft_modal']:
                    if key in st.session_state:
                        del st.session_state[key]
                # Use st.switch_page to navigate to drafts page
                st.switch_page("pages/mediaplandrafts.py")
        else:
            create_button = st.button(
                "✅ Create Draft",
                key="create_draft_btn",
                use_container_width=True,
                type="primary",
                disabled=not st.session_state.draft_budget_level or not st.session_state.draft_asset_format
            )

            if create_button:
                handle_create_draft(form_data, insights, api_service)


def handle_create_draft(form_data: Dict[str, Any], insights: Dict[str, Any], api_service):
    """
    Handle draft creation - matches React handleCreateDraft logic
    """

    budget_level = st.session_state.draft_budget_level
    asset_format = st.session_state.draft_asset_format

    # Validation
    if not budget_level or not asset_format:
        st.error("❌ Please provide budget amount and asset format")
        return

    with st.spinner("Creating draft..."):
        try:
            # Convert budget to micro units: budgetLevel (in k) * 1,000,000
            budget_in_thousands = budget_level
            budget_micro_amount = budget_in_thousands * 1000000

            # Use campaign name as budget name (matching React logic)
            budget_name = form_data.get('campaign_name', 'Unnamed Campaign')

            # Prepare draft data structure (matching React CreateDraftModal.tsx lines 83-112)
            draft_data = {
                'campaign_name': form_data.get('campaign_name', ''),
                'budget_name': budget_name,
                'budget_level': f"{budget_in_thousands}k",  # Format: "100k"
                'asset_format': asset_format,
                'form_data': {
                    **form_data,
                    'asset_formats': asset_format,
                    # Convert countries to single string if array
                    'countries': form_data['countries'][0] if isinstance(form_data.get('countries'), list) and len(form_data.get('countries', [])) > 0 else form_data.get('countries', 'US'),
                    # Ensure devices field is present
                    'devices': form_data.get('devices', ['DESKTOP']),
                    # Convert budget_type to valid enum value
                    'budget_type': 'LIFETIME' if form_data.get('budget_type') == 'TOTAL_BUDGET' else form_data.get('budget_type', 'LIFETIME'),
                    # Preserve original budget configuration
                    'micro_amount': form_data.get('micro_amount', budget_micro_amount),
                    # Add draft-specific budget information
                    'draft_budget_amount': budget_micro_amount,
                    'draft_budget_name': budget_name
                },
                'insights': {
                    **insights,
                    # Ensure bid estimates are integers
                    'bid_estimates': {
                        **insights.get('bid_estimates', {}),
                        'bid_estimate_min': round(insights.get('bid_estimates', {}).get('bid_estimate_min', 0)),
                        'bid_estimate_max': round(insights.get('bid_estimates', {}).get('bid_estimate_max', 0))
                    }
                }
            }

            # Debug output
            st.write("🔍 **Debug Info:**")
            st.json({
                "campaign_name": draft_data['campaign_name'],
                "budget_name": draft_data['budget_name'],
                "budget_level": draft_data['budget_level'],
                "asset_format": draft_data['asset_format'],
                "micro_amount": draft_data['form_data']['micro_amount']
            })

            # Call API to create draft
            response = api_service.create_draft(draft_data)

            # Handle response
            if response.get('success'):
                st.session_state.draft_created = True
                st.success(f"✅ Draft created successfully for {format_budget_display(budget_in_thousands)} budget with {asset_format} format!")

                # Show draft ID if available
                if response.get('draft'):
                    draft_id = response['draft'].get('id', 'N/A')
                    st.info(f"📝 Draft ID: {draft_id[:16]}...")

                st.rerun()
            else:
                error_msg = response.get('message', 'Failed to create draft')
                st.error(f"❌ Error Creating Draft: {error_msg}")

                # Show detailed error if available
                if response.get('errors'):
                    st.error(f"Details: {', '.join(response['errors'])}")

        except Exception as e:
            st.error(f"❌ Error: {str(e)}")
            import traceback
            st.code(traceback.format_exc())
